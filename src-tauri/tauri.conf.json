{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verba",
  "version": "0.7.0",
  "identifier": "com.nuvocode.verba",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verba",
        "width": 1040,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RTVCOEM4MzNEODNGNkMKUldSc1A5Z3p5TGpsNXNxcmlkMGw5OEt3VDJ3dzMrVFovZThLdUd1ckNOWThFU3dXZEVlb000M2QK"
    }
  }
}
